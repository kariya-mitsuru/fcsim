#!/usr/bin/python3 -s
"""fcsimctl - manage the initiator side and fabric of tcm_fcsim.

  fcsimctl status [--json]
  fcsimctl host create <wwpn> [--wwnn <wwnn>] [--link up|down]
  fcsimctl host delete <wwpn>
  fcsimctl link <wwpn> up|down
  fcsimctl lip <wwpn>
  fcsimctl fault list
  fcsimctl fault set <initiator> <target|any> [delay_ms=N] [drop=none|cmd|rsp]
                     [error=none|transport|busy|qfull|medium|aborted]
                     [probability=N] [count=N]
  fcsimctl fault clear <initiator> [<target|any>]
  fcsimctl stats <wwpn> [--reset]
  fcsimctl zone list
  fcsimctl zone create <name> [<wwpn>...] | delete <name>
  fcsimctl zone add|remove <name> <wwpn>...
  fcsimctl zone mode on|off
  fcsimctl zone commit | revert
                     zone edits and mode are staged; commit makes them
                     active at once, revert discards them
  fcsimctl fpin li|pn|dn|cn <wwpn> [event] [key=value...]
                     the fabric sends an FPIN about port <wwpn> to the
                     initiators zoned with it (cn: to that initiator)
  fcsimctl save <file.json>
  fcsimctl restore <file.json>
  fcsimctl clear

FPIN (the first event is the default):
  li <wwpn> [event] [count=N (1)] [threshold=ms (1000)]
       link_failure loss_of_sync loss_of_signal prim_seq_err
       invalid_tx_word invalid_crc device_specific unknown
  pn <wwpn> [event] [period=ms (1000)]
  cn <initiator wwpn> [event] [severity=warning|error (warning)] [period=ms (1000)]
       pn and cn: credit_stall lost_credit oversubscription device_specific clear
  dn <wwpn> [reason]
       timeout unable_to_route device_specific unknown

WWPNs are accepted as 10:00:00:00:c9:00:00:01, naa.10000000c9000001,
0x10000000c9000001 or 10000000c9000001.  targetcli (rtslib) only takes
naa WWNs whose first hex digit is 1, 2, 5 or c-f; host create warns about
an initiator WWPN it cannot name in an ACL.

The target side is managed with fcsim-targetcli.  fcsim-targetctl
save/restore/clear act on the whole of LIO, not only fcsim.  Restore the
target side before the initiator side.
"""

import argparse
import glob
import json
import os
import re
import sys

CFS = "/sys/kernel/config/fcsim"
HOSTS = CFS + "/hosts"
ZONING = CFS + "/zoning"
ZONES = CFS + "/zones"
LIO_FABRIC = "/sys/kernel/config/target/fcsim"
# These mirror the kernel; keep them in step (tests/cli-fcsim.sh checks the
# limits against it).  src/fcsim_fault.c: defaults in fcsim_faults_make_group,
# fcsim_drop_names, fcsim_error_names, FCSIM_FAULT_MAX_DELAY_MS and the
# probability / count stores.  src/fcsim_zone.c: FCSIM_ZONE_MAX_*.
FAULT_ATTRS = ("delay_ms", "drop", "error", "probability", "count")
FAULT_DEFAULTS = {"delay_ms": "0", "drop": "none", "error": "none",
                  "probability": "100", "count": "-1"}
FAULT_CHOICES = {"drop": ("none", "cmd", "rsp"),
                 "error": ("none", "transport", "busy", "qfull", "medium", "aborted")}
FAULT_RANGES = {"delay_ms": (0, 3600 * 1000), "probability": (0, 100),
                "count": (-1, 2**31 - 1)}
# Written while the rule is held off with count=0 (see fault_set).
FAULT_GATED = ("probability", "delay_ms", "drop", "error")
ZONE_MAX_MEMBERS = 128
ZONE_MAX_ZONES = 1024
SAVE_VERSION = 1


class Error(Exception):
    pass


# ------------------------------------------------------------------ helpers

def wwn(text):
    """Normalize a WWN to xx:xx:xx:xx:xx:xx:xx:xx."""
    t = text.strip().lower()
    for prefix in ("naa.", "0x"):
        if t.startswith(prefix):
            t = t[len(prefix):]
    t = t.replace(":", "")
    if not re.fullmatch(r"[0-9a-f]{16}", t) or int(t, 16) == 0:
        raise Error("invalid WWN: %s" % text)
    return ":".join(t[i:i + 2] for i in range(0, 16, 2))


def rtslib_naa_ok(w):
    """rtslib (targetcli, targetctl) takes naa.[125c-f]..., see
    rtslib_fb.utils.normalize_wwn."""
    return w[0] in "125cdef"


def rule_name(text):
    return "any" if text == "any" else wwn(text)


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        if default is None:
            raise
        return default


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
    except OSError as e:
        raise Error("%s: %s" % (path, e.strerror))


def make_dir(path, what):
    """mkdir a configfs group that must not exist yet."""
    if os.path.isdir(path):
        raise Error("%s exists: %s" % (what, os.path.basename(path)))
    try:
        os.mkdir(path)
    except OSError as e:
        raise Error("mkdir %s: %s" % (path, e.strerror))


def remove_dir(path):
    try:
        os.rmdir(path)
    except OSError as e:
        raise Error("rmdir %s: %s" % (path, e.strerror))


def write_json(path, obj):
    """Write obj as JSON, replacing path only once it is complete."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def lines(path):
    return [l for l in read(path, "").splitlines() if l]


def wwn_list(path):
    """(names, more) of a kernel WWN list attribute.  A list longer than a
    page ends in "... N more" instead of the remaining N names."""
    names, more = [], 0
    for l in lines(path):
        m = re.fullmatch(r"\.\.\. (\d+) more", l)
        if m:
            more += int(m.group(1))
        else:
            names.append(l)
    return names, more


def check_loaded():
    if not os.path.isdir(HOSTS):
        raise Error("tcm_fcsim is not loaded (%s missing)" % HOSTS)


def host_dir(w):
    d = os.path.join(HOSTS, wwn(w))
    if not os.path.isdir(d):
        raise Error("no such host: %s" % wwn(w))
    return d


def host_wwpns():
    return sorted(os.listdir(HOSTS)) if os.path.isdir(HOSTS) else []


# ------------------------------------------------------------------ state

def sd_devices(rport_dev):
    """sd devices under an rport: [(h:c:t:l, sdX, state)]."""
    out = []
    for blk in sorted(glob.glob(rport_dev + "/target*/*:*:*:*/block/*")):
        sdev = os.path.dirname(os.path.dirname(blk))
        out.append((os.path.basename(sdev), os.path.basename(blk),
                    read(sdev + "/state", "?")))
    return out


def host_state(w):
    d = os.path.join(HOSTS, w)
    shost = read(d + "/scsi_host")
    fch = "/sys/class/fc_host/" + shost
    rports = []
    for rp in sorted(glob.glob("/sys/class/scsi_host/%s/device/rport-*" % shost)):
        name = os.path.basename(rp)
        cls = "/sys/class/fc_remote_ports/" + name
        rports.append({
            "rport": name,
            "port_name": wwn(read(cls + "/port_name")),
            "port_id": read(cls + "/port_id", "?"),
            "state": read(cls + "/port_state", "?"),
            "dev_loss_tmo": read(cls + "/dev_loss_tmo", "?"),
            "fast_io_fail_tmo": read(cls + "/fast_io_fail_tmo", "?"),
            "luns": [{"hctl": h, "dev": s, "state": st}
                     for h, s, st in sd_devices(rp)],
        })
    faults = []
    for fd in sorted(glob.glob(d + "/faults/*")):
        f = {"target": os.path.basename(fd)}
        for a in FAULT_ATTRS + ("injected",):
            f[a] = read(os.path.join(fd, a))
        faults.append(f)
    targets, targets_more = wwn_list(d + "/targets")
    return {
        "wwpn": w,
        "wwnn": read(d + "/node_name"),
        "port_id": read(d + "/port_id"),
        "link": read(d + "/link"),
        "scsi_host": shost,
        "port_state": read(fch + "/port_state", "?"),
        "speed": read(fch + "/speed", "?"),
        "targets": targets,
        "targets_more": targets_more,	# not listed (page full)
        "draining": int(read(d + "/draining", "0")),
        "rports": rports,
        "faults": faults,
    }


def target_state():
    out = []
    for t in sorted(glob.glob(LIO_FABRIC + "/*/tpgt_1")):
        sessions, sessions_more = wwn_list(t + "/sessions")
        out.append({
            "wwpn": os.path.basename(os.path.dirname(t)),
            "port_id": read(t + "/port_id", "?"),
            "enabled": read(t + "/enable", "0") == "1",
            "luns": len(glob.glob(t + "/lun/lun_*")),
            "acls": sorted(os.path.basename(a) for a in glob.glob(t + "/acls/*")),
            "sessions": sessions,
            "sessions_more": sessions_more,	# not listed (page full)
        })
    return out


def fabric_state():
    return {
        "fabric_name": read(CFS + "/fabric_name"),
        "version": read(CFS + "/version"),
        "zoning": zoning_state(),
        "hosts": [host_state(w) for w in host_wwpns()],
        "targets": target_state(),
    }


# ------------------------------------------------------------------ commands

def cmd_status(args):
    st = fabric_state()
    if args.json:
        json.dump(st, sys.stdout, indent=2)
        print()
        return
    print("fabric %s (tcm_fcsim %s)" % (st["fabric_name"], st["version"]))
    zs = st["zoning"]
    print("zoning: %s, %d zone(s)%s" % (
        zs["active"]["mode"], len(zs["active"]["zones"]),
        "  (uncommitted changes: fcsimctl zone list)" if zs["pending"] else ""))
    if zs["active"]["mode"] == "on":
        for name, members in zs["active"]["zones"].items():
            print("  %s: %s" % (name, " ".join(members) or "(empty)"))
    print()
    print("target ports:")
    if not st["targets"]:
        print("  (none)")
    for t in st["targets"]:
        print("  %s  port_id %s  %s  luns %d  acls %d  sessions %d" % (
            t["wwpn"], t["port_id"], "enabled" if t["enabled"] else "disabled",
            t["luns"], len(t["acls"]), len(t["sessions"]) + t["sessions_more"]))
    print()
    print("initiator ports:")
    if not st["hosts"]:
        print("  (none)")
    for h in st["hosts"]:
        print("  %s  %s  port_id %s  link %s (%s, %s)%s" % (
            h["wwpn"], h["scsi_host"], h["port_id"], h["link"],
            h["port_state"], h["speed"],
            "  draining %d" % h["draining"] if h["draining"] else ""))
        for rp in h["rports"]:
            print("    -> %s  %s  %s  dev_loss_tmo %s  fast_io_fail_tmo %s" % (
                rp["port_name"], rp["rport"], rp["state"],
                rp["dev_loss_tmo"], rp["fast_io_fail_tmo"]))
            for lun in rp["luns"]:
                print("         %s  /dev/%s  %s" % (lun["hctl"], lun["dev"], lun["state"]))
        for f in h["faults"]:
            set_attrs = " ".join("%s=%s" % (a, f[a]) for a in FAULT_ATTRS
                                 if f[a] != FAULT_DEFAULTS[a])
            print("    fault %s: %s  (injected %s)" % (
                f["target"], set_attrs or "(no effect)", f["injected"]))


def host_create(w, wwnn=None, link="up"):
    d = os.path.join(HOSTS, w)
    make_dir(d, "host")
    # A new port starts with its link down: nothing logs in before it is set up.
    try:
        if wwnn:
            write(d + "/node_name", wwnn)
        if link == "up":
            write(d + "/link", "up")
    except Error:
        os.rmdir(d)
        raise
    return d


def host_delete(w):
    d = host_dir(w)
    for fd in glob.glob(d + "/faults/*"):
        remove_dir(fd)
    remove_dir(d)


def cmd_host(args):
    w = wwn(args.wwpn)
    if args.action == "create":
        if not rtslib_naa_ok(w):
            print("fcsimctl: warning: targetcli cannot name %s in an ACL "
                  "(naa WWNs must start with 1, 2, 5 or c-f); use "
                  "generate_node_acls or the configfs directory" % w,
                  file=sys.stderr)
        host_create(w, wwn(args.wwnn) if args.wwnn else None, args.link)
        print("%s: %s" % (w, read(os.path.join(HOSTS, w, "scsi_host"))))
    else:
        host_delete(w)


def cmd_link(args):
    write(host_dir(args.wwpn) + "/link", args.state)


def cmd_lip(args):
    shost = read(host_dir(args.wwpn) + "/scsi_host")
    write("/sys/class/fc_host/%s/issue_lip" % shost, "1")


def fault_check(attrs):
    """Validate and normalize fault attributes the way the kernel would."""
    out = {}
    for k, v in attrs.items():
        if k not in FAULT_ATTRS:
            raise Error("unknown fault attribute: %s (one of %s)" % (k, ", ".join(FAULT_ATTRS)))
        v = str(v).strip()
        if k in FAULT_CHOICES:
            if v not in FAULT_CHOICES[k]:
                raise Error("fault %s: one of %s, not %r" % (k, "|".join(FAULT_CHOICES[k]), v))
        else:
            try:
                n = int(v, 0)
            except ValueError:
                raise Error("fault %s: not a number: %r" % (k, v))
            lo, hi = FAULT_RANGES[k]
            if not lo <= n <= hi:
                raise Error("fault %s: %d is out of range %d..%d" % (k, n, lo, hi))
            v = str(n)
        out[k] = v
    return out


def fault_set(hdir, target, attrs):
    """Create or update a fault rule so that I/O never sees a mix of old and
    new attributes: count=0 stops the rule from injecting while the others
    are written, and the final count goes in last."""
    attrs = fault_check(attrs)
    fd = os.path.join(hdir, "faults", target)
    created = not os.path.isdir(fd)
    if created:
        make_dir(fd, "fault rule")
        old = dict(FAULT_DEFAULTS)
    else:
        old = {k: read(os.path.join(fd, k)) for k in FAULT_ATTRS}
    try:
        # What is left of count goes back in at the end: read it right before
        # holding the rule off, so that commands the rule caught meanwhile
        # are not given back.
        if not created:
            old["count"] = read(os.path.join(fd, "count"))
        write(os.path.join(fd, "count"), "0")
        for k in FAULT_GATED:
            if k in attrs:
                write(os.path.join(fd, k), attrs[k])
        write(os.path.join(fd, "count"), attrs.get("count", old["count"]))
    except (Error, OSError):
        if created:
            try:
                os.rmdir(fd)
            except OSError:
                pass
        else:
            for k in FAULT_GATED + ("count",):
                try:
                    write(os.path.join(fd, k), old[k])
                except Error:
                    pass
        raise


def cmd_fault(args):
    if args.action == "list" and (args.initiator or args.target):
        raise Error("fault list takes no arguments")
    if args.action == "clear" and args.attrs:
        raise Error("fault clear: <initiator> [<target|any>] only")
    if args.action == "list":
        for w in host_wwpns():
            for f in host_state(w)["faults"]:
                print("%s %s %s injected=%s" % (
                    w, f["target"],
                    " ".join("%s=%s" % (a, f[a]) for a in FAULT_ATTRS), f["injected"]))
        return
    if not args.initiator:
        raise Error("fault %s: initiator WWPN required" % args.action)
    hdir = host_dir(args.initiator)
    if args.action == "set":
        if not args.target:
            raise Error("fault set: target WWPN or 'any' required")
        attrs = {}
        for kv in args.attrs:
            if "=" not in kv:
                raise Error("expected attr=value: %s" % kv)
            k, v = kv.split("=", 1)
            attrs[k] = v
        fault_set(hdir, rule_name(args.target), attrs)
    else:
        targets = [rule_name(args.target)] if args.target else \
            [os.path.basename(p) for p in glob.glob(hdir + "/faults/*")]
        for t in targets:
            fd = os.path.join(hdir, "faults", t)
            if os.path.isdir(fd):
                remove_dir(fd)


def cmd_stats(args):
    shost = read(host_dir(args.wwpn) + "/scsi_host")
    sdir = "/sys/class/fc_host/%s/statistics" % shost
    if args.reset:
        write(sdir + "/reset_statistics", "1")
        return
    for p in sorted(glob.glob(sdir + "/*")):
        name = os.path.basename(p)
        if name == "reset_statistics":
            continue
        v = read(p, "")
        try:
            v = str(int(v, 16))
        except ValueError:
            pass
        print("%-28s %s" % (name, v))


# ------------------------------------------------------------------ zoning

def staged_zones():
    """{name: [wwpn...]} of the staged zones."""
    return {os.path.basename(z): lines(z + "/members")
            for z in sorted(glob.glob(ZONES + "/*"))}


def active_zoning():
    """(mode, {name: [wwpn...]}) of the active configuration."""
    mode, zones = "off", {}
    for l in read(ZONING + "/active").splitlines():
        f = l.split()
        if not f:
            continue
        if f[0] == "mode":
            mode = f[1]
        elif f[0] == "zone":
            zones[f[1]] = f[2:]
    return mode, zones


def zoning_state():
    mode, zones = active_zoning()
    return {
        "active": {"mode": mode, "zones": zones},
        "staged": {"mode": read(ZONING + "/mode"), "zones": staged_zones()},
        "pending": read(ZONING + "/pending") == "1",
    }


def zone_dir(name, must_exist=True):
    # The name becomes a path: check it before it can escape ZONES.
    d = os.path.join(ZONES, zone_name_check(name))
    if must_exist and not os.path.isdir(d):
        raise Error("no such zone: %s" % name)
    return d


def zone_set_members(name, members):
    write(zone_dir(name) + "/members", "\n".join(members) + "\n")


def zone_create(name, members=()):
    make_dir(zone_dir(name, must_exist=False), "zone")
    if members:
        zone_set_members(name, members)


def zones_replace_staged(mode, zones):
    """Make the staged configuration exactly (mode, zones)."""
    for name in staged_zones():
        if name not in zones:
            remove_dir(zone_dir(name))
    have = staged_zones()
    for name, members in zones.items():
        if name not in have:
            zone_create(name)
        zone_set_members(name, [wwn(m) for m in members])
    write(ZONING + "/mode", mode)


def zone_commit():
    write(ZONING + "/commit", "1")


def cmd_zone(args):
    a, rest = args.action, args.args
    if a in ("list", "commit", "revert") and rest:
        raise Error("zone %s takes no arguments" % a)
    if a == "list":
        st = zoning_state()
        for which in ("active", "staged"):
            z = st[which]
            print("%s: mode %s" % (which, z["mode"]))
            for name, members in z["zones"].items():
                print("  %s: %s" % (name, " ".join(members) or "(empty)"))
        print("pending: %s" % ("yes" if st["pending"] else "no"))
    elif a in ("create", "delete", "add", "remove"):
        if not rest:
            raise Error("zone %s: zone name required" % a)
        if a == "delete" and len(rest) > 1:
            raise Error("zone delete takes one zone name")
        name, members = rest[0], [wwn(m) for m in rest[1:]]
        if a == "create":
            zone_create(name, members)
        elif a == "delete":
            remove_dir(zone_dir(name))
        else:
            if not members:
                raise Error("zone %s: WWPNs required" % a)
            cur = lines(zone_dir(name) + "/members")
            if a == "add":
                cur += [m for m in members if m not in cur]
            else:
                cur = [m for m in cur if m not in members]
            zone_set_members(name, cur)
    elif a == "mode":
        if rest not in (["on"], ["off"]):
            raise Error("zone mode on|off")
        write(ZONING + "/mode", rest[0])
    elif a == "commit":
        zone_commit()
    elif a == "revert":
        mode, zones = active_zoning()
        zones_replace_staged(mode, zones)
    else:
        raise Error("unknown zone action: %s" % a)


def cmd_fpin(args):
    write(CFS + "/fpin", " ".join([args.kind, wwn(args.wwpn)] + args.opts))


def saved_config():
    hosts = []
    for w in host_wwpns():
        h = host_state(w)
        hosts.append({
            "wwpn": w,
            "wwnn": h["wwnn"],
            "link": h["link"],
            "faults": [{k: f[k] for k in ("target",) + FAULT_ATTRS}
                       for f in h["faults"]],
        })
    return {
        "version": SAVE_VERSION,
        "zoning": {"mode": read(ZONING + "/mode"), "zones": staged_zones()},
        "hosts": hosts,
    }


def cmd_save(args):
    write_json(args.file, saved_config())


def clear_all():
    for w in host_wwpns():
        host_delete(w)
    zones_replace_staged("off", {})
    zone_commit()


def cmd_clear(args):
    clear_all()


def zone_name_check(name):
    # The kernel takes one printable word without ',' (fcsim_zones_make_group);
    # '/', '.' and '..' cannot be directory names.
    if (not isinstance(name, str) or not re.fullmatch(r"[!-~]+", name)
            or "," in name or "/" in name or name in (".", "..")):
        raise Error("invalid zone name: %r" % (name,))
    return name


def restore_plan(cfg):
    """Validate a saved configuration and return it normalized, without
    touching the fabric."""
    def expect(what, value, typ):
        if not isinstance(value, typ):
            raise Error("%s: expected %s, got %r" % (what, typ.__name__, value))
        return value

    def known(what, d, keys):
        # A misspelt key would otherwise vanish without a trace.
        extra = sorted(set(d) - set(keys))
        if extra:
            raise Error("%s: unknown key%s %s (known: %s)" % (
                what, "s" if len(extra) > 1 else "", ", ".join(map(repr, extra)),
                ", ".join(keys)))

    expect("config", cfg, dict)
    known("config", cfg, ("version", "zoning", "hosts"))
    if cfg.get("version") != SAVE_VERSION:
        raise Error("unsupported config version: %r" % cfg.get("version"))

    z = expect("zoning", cfg.get("zoning", {}), dict)
    known("zoning", z, ("mode", "zones"))
    mode = z.get("mode", "off")
    if mode not in ("on", "off"):
        raise Error("zoning mode: on|off, not %r" % (mode,))
    zones = {}
    for name, members in expect("zoning.zones", z.get("zones", {}), dict).items():
        zone_name_check(name)
        expect("zone %s" % name, members, list)
        ms = []
        for m in members:
            m = wwn(expect("zone %s member" % name, m, str))
            if m not in ms:
                ms.append(m)
        if len(ms) > ZONE_MAX_MEMBERS:
            raise Error("zone %s: more than %d members" % (name, ZONE_MAX_MEMBERS))
        zones[name] = ms
    if len(zones) > ZONE_MAX_ZONES:
        raise Error("more than %d zones" % ZONE_MAX_ZONES)

    tports = set()
    for p in glob.glob(LIO_FABRIC + "/*"):
        try:
            tports.add(wwn(os.path.basename(p)))
        except Error:
            pass		# discovery_auth and the like
    hosts, seen = [], set()
    for h in expect("hosts", cfg.get("hosts", []), list):
        expect("host", h, dict)
        w = wwn(expect("host wwpn", h.get("wwpn"), str))
        known("host %s" % w, h, ("wwpn", "wwnn", "link", "faults"))
        if w in seen:
            raise Error("host %s: listed twice" % w)
        if w in tports:
            raise Error("host %s: WWPN is in use by a target port" % w)
        seen.add(w)
        wwnn = h.get("wwnn")
        wwnn = wwn(expect("host %s wwnn" % w, wwnn, str)) if wwnn else None
        link = h.get("link", "up")
        if link not in ("up", "down"):
            raise Error("host %s: link up|down, not %r" % (w, link))
        faults, targets = [], set()
        for f in expect("host %s faults" % w, h.get("faults", []), list):
            expect("host %s fault" % w, f, dict)
            t = rule_name(expect("host %s fault target" % w, f.get("target"), str))
            known("host %s fault %s" % (w, t), f, ("target",) + FAULT_ATTRS)
            if t in targets:
                raise Error("host %s: two fault rules for %s" % (w, t))
            targets.add(t)
            faults.append((t, fault_check({k: f[k] for k in FAULT_ATTRS if k in f})))
        hosts.append({"wwpn": w, "wwnn": wwnn, "link": link, "faults": faults})
    return {"mode": mode, "zones": zones, "hosts": hosts}


def restore_apply(plan):
    # Zoning first, so that the hosts log in under it from the start.
    zones_replace_staged(plan["mode"], plan["zones"])
    zone_commit()
    for h in plan["hosts"]:
        # The link comes up only after the fault rules are in, so that I/O
        # after the restore sees all of them.
        d = host_create(h["wwpn"], h["wwnn"], "down")
        for t, attrs in h["faults"]:
            fault_set(d, t, attrs)
        write(d + "/link", h["link"])


def cmd_restore(args):
    try:
        with open(args.file) as f:
            cfg = json.load(f)
    except OSError as e:
        raise Error("%s: %s" % (args.file, e.strerror))
    except ValueError as e:
        raise Error("%s: not valid JSON: %s" % (args.file, e))
    plan = restore_plan(cfg)

    # Nothing has changed so far.  From here on a failure (the kernel refusing
    # something) leaves the fabric half restored, so keep what was there.
    backup = saved_config()
    clear_all()
    try:
        restore_apply(plan)
    except (Error, OSError) as e:
        bak = args.file + ".before-restore"
        try:
            write_json(bak, backup)
            hint = "the previous configuration is in %s (fcsimctl restore %s)" % (bak, bak)
        except OSError:
            hint = "previous configuration:\n" + json.dumps(backup, indent=2)
        raise Error("restore failed part way: %s\n%s" % (e, hint))


# ------------------------------------------------------------------ main

def main():
    p = argparse.ArgumentParser(
        prog="fcsimctl", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="show the fabric")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("host", help="create / delete an initiator port")
    s.add_argument("action", choices=("create", "delete"))
    s.add_argument("wwpn")
    s.add_argument("--wwnn")
    s.add_argument("--link", choices=("up", "down"), default="up")
    s.set_defaults(func=cmd_host)

    s = sub.add_parser("link", help="set an initiator port's link up / down")
    s.add_argument("wwpn")
    s.add_argument("state", choices=("up", "down"))
    s.set_defaults(func=cmd_link)

    s = sub.add_parser("lip", help="retry logins and rescan (issue_lip)")
    s.add_argument("wwpn")
    s.set_defaults(func=cmd_lip)

    s = sub.add_parser("fault", help="fault injection rules")
    s.add_argument("action", choices=("list", "set", "clear"))
    s.add_argument("initiator", nargs="?")
    s.add_argument("target", nargs="?", help="target WWPN or 'any'")
    s.add_argument("attrs", nargs="*", metavar="attr=value")
    s.set_defaults(func=cmd_fault)

    s = sub.add_parser("stats", help="fc_host statistics of an initiator port")
    s.add_argument("wwpn")
    s.add_argument("--reset", action="store_true")
    s.set_defaults(func=cmd_stats)

    s = sub.add_parser("zone", help="zoning (staged; commit to apply)")
    s.add_argument("action", choices=("list", "create", "delete", "add", "remove",
                                      "mode", "commit", "revert"))
    s.add_argument("args", nargs="*", metavar="arg")
    s.set_defaults(func=cmd_zone)

    s = sub.add_parser("fpin", help="send a Fabric Performance Impact Notification")
    s.add_argument("kind", choices=("li", "pn", "dn", "cn"),
                   help="link integrity, peer congestion, delivery, congestion")
    s.add_argument("wwpn", help="the port the notification is about")
    s.add_argument("opts", nargs="*", metavar="event|key=value")
    s.set_defaults(func=cmd_fpin)

    s = sub.add_parser("save", help="save zoning, hosts, links and fault rules as JSON")
    s.add_argument("file")
    s.set_defaults(func=cmd_save)

    s = sub.add_parser("restore", help="replace the configuration with a saved one")
    s.add_argument("file")
    s.set_defaults(func=cmd_restore)

    s = sub.add_parser("clear", help="delete all initiator ports, fault rules and zones")
    s.set_defaults(func=cmd_clear)

    args = p.parse_args()
    try:
        check_loaded()
        args.func(args)
    except (Error, OSError) as e:
        print("fcsimctl: %s" % e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
